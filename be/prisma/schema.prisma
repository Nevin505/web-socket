
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
 enum GroupRole{
  ADMIN
  MEMBER
  OWNER
}
 enum InvitationStatus{
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  username     String?  @unique
  bio          String   @default("")
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  groupsCreated Group[] @relation("groupsCreated")
  memberships   GroupMember[] @relation("userMemberships")
  invitations   GroupInvitation[] @relation("userInvitations")
}

model  Group{
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  maxMembers Int @default(4)
  members GroupMember[] @relation("groupMembers")
  createdById String 
  createdBy User @relation("groupsCreated",fields: [createdById], references: [id])
  invitations GroupInvitation[] @relation("groupInvitations")
}
model GroupMember{
  id String @id @default(cuid())
  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt          
  groupId String
  userId String
  role     GroupRole @default(MEMBER)
  group Group @relation("groupMembers",fields: [groupId], references: [id])
  users User @relation("userMemberships",fields: [userId], references: [id])
  
 @@unique([groupId, userId])
}

model GroupInvitation{
  id String @id @default(cuid())
  token String @unique
  groupId String
  group Group @relation("groupInvitations",fields:[groupId],references:[id])
  userId String
  email String
  invitedById String
  invitedByUser User @relation("userInvitations",fields:[invitedById],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accepetdAt DateTime?
  expiresAt DateTime
  status InvitationStatus @default(PENDING)
}